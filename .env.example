# Application
MODEL_PROVIDER=ollama
FALLBACK_MODEL_PROVIDER=groq
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true

# LLM fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Paths
DB_PATH=data/job_hunt.db
CHROMA_PATH=data/chroma_db
RESUME_DIR=data/resumes

# Matching
MATCH_THRESHOLD=0.95
MAX_RESULTS_PER_BOARD=200
BATCH_SIZE=50

# Email / tracking
MAX_EMAILS_PER_HOUR=10
FOLLOWUP_CHECK_INTERVAL_MINUTES=30
DAYS_BEFORE_FOLLOWUP=3
MAX_FOLLOWUPS=2

# SMTP / IMAP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Application
MODEL_PROVIDER=ollama
FALLBACK_MODEL_PROVIDER=groq
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true

# LLM fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Paths
DB_PATH=data/job_hunt.db
CHROMA_PATH=data/chroma_db
RESUME_DIR=data/resumes

# Matching - Stage 1 weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.35
TFIDF_WEIGHT=0.30
SKILL_OVERLAP_WEIGHT=0.35

# Matching - Stage 2 weights (must sum to 1.0)
FINAL_SEMANTIC_WEIGHT=0.30
FINAL_TFIDF_WEIGHT=0.25
FINAL_SKILL_WEIGHT=0.25
LLM_VERIFICATION_WEIGHT=0.20

# Thresholds
SEMANTIC_PRE_FILTER_THRESHOLD=0.30
MATCH_THRESHOLD=0.50

# Score bands (for interpretation labels)
SCORE_BAND_STRONG_MIN=0.70
SCORE_BAND_MODERATE_MIN=0.50

# Search behavior
MAX_RESULTS_PER_BOARD=200
BATCH_SIZE=50

ENABLED_SOURCES=indeed,linkedin,wellfound,cutshort
MAX_DETAIL_FETCHES=20
REQUEST_TIMEOUT_SECONDS=20
SOURCE_FAILURE_THRESHOLD=3
MAX_CONCURRENT_FETCHES=6
MIN_DESCRIPTION_CHARS=80
# Optional comma separated proxy list for bot-protected boards
JOBSPY_PROXIES=

# Email / tracking
MAX_EMAILS_PER_HOUR=10
FOLLOWUP_CHECK_INTERVAL_MINUTES=30
DAYS_BEFORE_FOLLOWUP=3
MAX_FOLLOWUPS=2

# SMTP / IMAP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

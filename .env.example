# Application
MODEL_PROVIDER=ollama
FALLBACK_MODEL_PROVIDER=groq
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true

# LLM fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Paths
DB_PATH=data/job_hunt.db
CHROMA_PATH=data/chroma_db
RESUME_DIR=data/resumes

# Matching
# Composite match score threshold (0.0-1.0). Real resume/job-description
# pairs score roughly 0.3-0.7, so 0.95 would reject every job.
MATCH_THRESHOLD=0.50
MAX_RESULTS_PER_BOARD=200
BATCH_SIZE=50

ENABLED_SOURCES=indeed,linkedin,wellfound,cutshort
MAX_DETAIL_FETCHES=20
REQUEST_TIMEOUT_SECONDS=20
SOURCE_FAILURE_THRESHOLD=3
MAX_CONCURRENT_FETCHES=6
MIN_DESCRIPTION_CHARS=80
# Optional comma separated proxy list for bot-protected boards
JOBSPY_PROXIES=

# Email / tracking
MAX_EMAILS_PER_HOUR=10
FOLLOWUP_CHECK_INTERVAL_MINUTES=30
DAYS_BEFORE_FOLLOWUP=3
MAX_FOLLOWUPS=2

# SMTP / IMAP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
